From: cool_fox Linux fork
Subject: [PATCH] server: Index process views by base address.

Each process's memory views were kept in a list that find_mapped_view,
find_mapped_addr and is_valid_view_addr searched from the start on every
map_view, map_image_view and unmap_view request. A title that maps and
unmaps 64 KiB physical-page views thousands of times a second over some
25,000 views spent 35-40% of all CPU time in those two searches (perf,
wine-staging 11.22). The views now also live in an rb-tree keyed by base
address, so each lookup is logarithmic; the list keeps its order (main exe
first, then load order) for the debug events that walk it.

Applies on wine 11.22 with wine-staging v11.22.
---
diff --git a/server/file.h b/server/file.h
index 666508a..e84eb34 100644
--- a/server/file.h
+++ b/server/file.h
@@ -184,6 +184,8 @@ extern struct file *get_view_file( const struct memory_view *view, unsigned int
 extern const struct pe_image_info *get_view_image_info( const struct memory_view *view, client_ptr_t *base );
 extern int get_view_nt_name( const struct memory_view *view, struct unicode_str *name );
 extern void free_mapped_views( struct process *process );
+#include "wine/rbtree.h"
+extern int compare_view_base( const void *key, const struct rb_entry *entry );
 extern size_t get_page_size(void);
 extern struct mapping *create_fd_mapping( struct object *root, struct unicode_str name, struct fd *fd,
                                           unsigned int attr, const struct security_descriptor *sd );
diff --git a/server/mapping.c b/server/mapping.c
index d1b0fc3..6898a56 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -98,6 +98,7 @@ static struct list shared_map_list = LIST_INIT( shared_map_list );
 struct memory_view
 {
     struct list     entry;           /* entry in per-process view list */
+    struct rb_entry tree_entry;      /* entry in per-process view tree (by base) */
     struct fd      *fd;              /* fd for mapped file */
     struct ranges  *committed;       /* list of committed ranges in this mapping */
     struct shared_map *shared;       /* temp file for shared PE mapping */
@@ -384,14 +385,42 @@ static int create_temp_file( file_pos_t size )
     return fd;
 }
 
+/* order of the per-process view tree: by base address */
+int compare_view_base( const void *key, const struct rb_entry *entry )
+{
+    client_ptr_t base = *(const client_ptr_t *)key;
+    const struct memory_view *view = RB_ENTRY_VALUE( entry, const struct memory_view, tree_entry );
+
+    if (base < view->base) return -1;
+    if (base > view->base) return 1;
+    return 0;
+}
+
+/* the view with the highest base address below or at addr, or NULL */
+static struct memory_view *find_view_at_or_below( struct process *process, client_ptr_t addr )
+{
+    struct rb_entry *ptr = process->views_tree.root;
+    struct memory_view *best = NULL;
+
+    while (ptr)
+    {
+        struct memory_view *view = RB_ENTRY_VALUE( ptr, struct memory_view, tree_entry );
+        if (view->base <= addr)
+        {
+            best = view;
+            ptr = ptr->right;
+        }
+        else ptr = ptr->left;
+    }
+    return best;
+}
+
 /* find a memory view from its base address */
 struct memory_view *find_mapped_view( struct process *process, client_ptr_t base )
 {
-    struct memory_view *view;
-
-    LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
-        if (view->base == base) return view;
+    struct rb_entry *ptr = rb_get( &process->views_tree, &base );
 
+    if (ptr) return RB_ENTRY_VALUE( ptr, struct memory_view, tree_entry );
     set_error( STATUS_NOT_MAPPED_VIEW );
     return NULL;
 }
@@ -399,11 +428,9 @@ struct memory_view *find_mapped_view( struct process *process, client_ptr_t base
 /* find a memory view from any address inside it */
 static struct memory_view *find_mapped_addr( struct process *process, client_ptr_t addr )
 {
-    struct memory_view *view;
-
-    LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
-        if (addr >= view->base && addr < view->base + view->size) return view;
+    struct memory_view *view = find_view_at_or_below( process, addr );
 
+    if (view && addr < view->base + view->size) return view;
     set_error( STATUS_NOT_MAPPED_VIEW );
     return NULL;
 }
@@ -417,13 +444,10 @@ static int is_valid_view_addr( struct process *process, client_ptr_t addr, mem_s
     if (addr & (process->page_size - 1)) return 0;
     if (addr + size < addr) return 0;  /* overflow */
 
-    /* check for overlapping view */
-    LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
-    {
-        if (view->base + view->size <= addr) continue;
-        if (view->base >= addr + size) continue;
-        return 0;
-    }
+    /* check for overlapping view: views do not overlap each other, so only the
+     * one starting closest below the end of the range can reach into it */
+    view = find_view_at_or_below( process, addr + size - 1 );
+    if (view && view->base + view->size > addr) return 0;
     return 1;
 }
 
@@ -462,19 +486,22 @@ static int add_process_view( struct thread *thread, struct memory_view *view )
                 process->imagelen = name.len;
             process->image_info = view->image;
             list_add_head( &process->views, &view->entry );
+            rb_put( &process->views_tree, &view->base, &view->tree_entry );
             return 1;
         }
     }
     list_add_tail( &process->views, &view->entry );
+    rb_put( &process->views_tree, &view->base, &view->tree_entry );
     return 0;
 }
 
-static void free_memory_view( struct memory_view *view )
+static void free_memory_view( struct process *process, struct memory_view *view )
 {
     if (view->fd) release_object( view->fd );
     if (view->committed) release_object( view->committed );
     if (view->shared) release_object( view->shared );
     list_remove( &view->entry );
+    rb_remove( &process->views_tree, &view->tree_entry );
     free( view );
 }
 
@@ -484,7 +511,7 @@ void free_mapped_views( struct process *process )
     struct list *ptr;
 
     while ((ptr = list_head( &process->views )))
-        free_memory_view( LIST_ENTRY( ptr, struct memory_view, entry ));
+        free_memory_view( process, LIST_ENTRY( ptr, struct memory_view, entry ));
 }
 
 /* find the shared PE mapping for a given mapping */
@@ -1797,7 +1824,7 @@ DECL_HANDLER(unmap_view)
 
     if (!view) return;
     generate_dll_event( current, DbgUnloadDllStateChange, view );
-    free_memory_view( view );
+    free_memory_view( current->process, view );
 }
 
 /* get information about a mapped image view */
diff --git a/server/process.c b/server/process.c
index 510faf1..6aac256 100644
--- a/server/process.c
+++ b/server/process.c
@@ -648,6 +648,7 @@ struct process *create_process( int fd, struct process *parent, unsigned int fla
     list_init( &process->asyncs );
     list_init( &process->classes );
     list_init( &process->views );
+    rb_init( &process->views_tree, compare_view_base );
 
     process->end_time = 0;
 
diff --git a/server/process.h b/server/process.h
index dff766d..350b6cc 100644
--- a/server/process.h
+++ b/server/process.h
@@ -22,6 +22,7 @@
 #define __WINE_SERVER_PROCESS_H
 
 #include "object.h"
+#include "wine/rbtree.h"
 
 struct atom_table;
 struct handle_table;
@@ -80,6 +81,7 @@ struct process
     obj_handle_t         desktop;         /* handle to desktop to use for new threads */
     struct token        *token;           /* security token associated with this process */
     struct list          views;           /* list of memory views */
+    struct rb_tree       views_tree;      /* the same views by base address */
     client_ptr_t         peb;             /* PEB address in client address space */
     struct dir_cache    *dir_cache;       /* map of client-side directory cache */
     unsigned int         trace_data;      /* opaque data used by the process tracing mechanism */
